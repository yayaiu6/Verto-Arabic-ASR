pid /tmp/nginx.pid;
events { worker_connections 1024; }
http {
 include /etc/nginx/mime.types;
 types { application/wasm wasm; text/javascript mjs; }
 default_type application/octet-stream;
 client_body_temp_path /tmp/client_temp;
 proxy_temp_path /tmp/proxy_temp;
 fastcgi_temp_path /tmp/fastcgi_temp;
 uwsgi_temp_path /tmp/uwsgi_temp;
 scgi_temp_path /tmp/scgi_temp;
 server {
  listen ${PORT};
  # TLS terminates at the hosting proxy; never expose its internal port/scheme.
  absolute_redirect off;
  root /usr/share/nginx/html;
  add_header Cross-Origin-Opener-Policy same-origin always;
  add_header Cross-Origin-Embedder-Policy require-corp always;
  add_header X-Content-Type-Options nosniff always;
  location = /health { access_log off; return 200 'ok'; }
  location = / { return 302 /web/index.html; }
  location / { try_files $uri =404; add_header Cache-Control 'no-cache'; add_header Cross-Origin-Opener-Policy same-origin always; add_header Cross-Origin-Embedder-Policy require-corp always; }
  location ~ ^/(runtime|ffmpeg)/ { add_header Cache-Control 'public, max-age=31536000, immutable'; add_header Cross-Origin-Opener-Policy same-origin always; add_header Cross-Origin-Embedder-Policy require-corp always; try_files $uri =404; }
 }
}
